# Supabase — vezi Project Settings > API în dashboard-ul Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NICIODATĂ expusă către browser — doar server-side (route handlers, scripturi).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# DOAR development: dezactivează complet autentificarea (vezi paginile fără
# login). NU seta pe un mediu accesibil public — omite din producție.
# DISABLE_AUTH=true
# DISABLE_AUTH_ROLE=LOCATAR
